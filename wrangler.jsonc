/* ==========================================================================
   WBA — Cloudflare Workers, serving the site as static assets.

   WHY A WORKER AND NOT PAGES
   Not a preference. Cloudflare merged the two dashboards, and "Connect to
   Git" now creates a Worker and runs `npx wrangler deploy`. Without this file
   that command has nothing to deploy and the build fails on a repo that is
   otherwise perfectly fine — which is exactly what happened.

   It is also the better target. With `assets` below, a request matching a
   real file is served straight from Cloudflare's edge WITHOUT invoking the
   Worker: those requests are free and uncapped on every plan, including the
   free one. The Worker script only runs for paths that are NOT a file —
   the two API proxies and preview URLs — which is a few hundred requests a
   month, against a 100,000/day allowance.

   So: no credit system, no deploy budget, no hard stop. The thing that
   stopped Netlify cannot happen here.
   ========================================================================== */
{
  "name": "wba-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",

  "assets": {
    /* The repo IS the site — there is no build step. The Feed is generated by
       GitHub Actions and committed, so Cloudflare has nothing to compile. */
    "directory": "./",
    "binding": "ASSETS",

    /* A missing page gets our own 404.html rather than Cloudflare's. */
    "not_found_handling": "404-page",

    /* Assets are served without waking the Worker unless the path matches
       one of these. Keeping this list short is what keeps the Worker's
       request count near zero. */
    "run_worker_first": ["/api/*", "/preview/*"]
  },

  "observability": {
    "enabled": true
  }
}
